<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Roslyn analyzer enforcing the simulation's banned-API policy at compile time.
    Built against Microsoft.CodeAnalysis 3.8, the version Unity's analyzer support expects,
    so the Unity host (#3) can run the same check.
  -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <IsRoslynComponent>true</IsRoslynComponent>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Release tracking is for analyzers shipped as packages; this one never leaves the repo. -->
    <NoWarn>$(NoWarn);RS2008</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="3.8.0" PrivateAssets="all" />
  </ItemGroup>

</Project>
