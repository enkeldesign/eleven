<Project Sdk="Microsoft.NET.Sdk">

  <!-- The host's engine-free pieces, compiled straight from unity/Assets (#55): they use System and the
       engine-free assemblies only, so .NET can test them without Unity. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="../../unity/Assets/Eleven.Host/FramePacing.cs" Link="Host/FramePacing.cs" />
    <Compile Include="../../unity/Assets/Eleven.Host/ActionPoses.cs" Link="Host/ActionPoses.cs" />
  </ItemGroup>

  <!-- ActionPoses (#101) reads the simulation's state and names the presentation's poses. -->
  <ItemGroup>
    <ProjectReference Include="../../src/Eleven.Simulation/Eleven.Simulation.csproj" />
    <ProjectReference Include="../../src/Eleven.Presentation/Eleven.Presentation.csproj" />
  </ItemGroup>

</Project>
